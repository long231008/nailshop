DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nailshop
# Use rediss:// (double s) instead of redis:// for TLS-required providers (Upstash, Redis Cloud)
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
# Sessions can be long-lived: every request re-checks the user in the database,
# so blocking an account cuts access immediately regardless of token lifetime.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-secret
PAYMENT_CHECKOUT_BASE_URL=https://payments.example.com/checkout
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/app/auth/google/callback
# Optional - leave blank to keep Facebook login disabled
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/app/auth/facebook/callback
# Where the browser lands after Google OAuth completes (the frontend's own URL)
FRONTEND_URL=http://localhost:5173
# Which websites may call this API from a browser. Production: your real
# frontend origin(s), e.g. https://nailzinc.co.uk - never *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Which Host headers this API answers to. Production: your API domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1
# Business timezone: opening hours and daily stats follow this wall clock
SHOP_TIMEZONE=Europe/London
# How messages reach customers:
#   console = print OTP/notifications to the log (LOCAL DEV ONLY)
#   null    = record that a message was due, without its contents
#   live    = deliver for real (SMS to phone numbers, email to addresses)
NOTIFICATION_BACKEND=console

# --- Email delivery (free) -------------------------------------------------
# Pick ONE: SendGrid's API, or SMTP - which works with the free tiers of Brevo,
# Resend and Mailgun, or a Gmail app password. See DEPLOYMENT.md for hosts.
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Must be an address the provider lets you send from
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Nailzinc

# --- SMS delivery (Twilio, paid) -------------------------------------------
# Optional: leave blank to run on email alone. TWILIO_SENDER is a purchased
# number (+44...) or an approved alphanumeric sender ID such as "Nailzinc".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER=
# Numbers are stored as customers type them ("07..."); this makes them E.164
SMS_COUNTRY_CODE=+44
# When a customer has both a phone and an email, email is free - use it
PREFER_EMAIL_OVER_SMS=true
# Set to true only behind a proxy you control (enables X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=false
# Log every SQL statement (very noisy; local debugging only)
SQL_ECHO=false

# ===== Business rules (all optional - defaults shown) =====
# The shop's wall clock; days, opening hours and the nightly close follow it.
# SHOP_TIMEZONE=Europe/London
# Open hours and the last accepted booking start (a long treatment may run
# past closing - that is the salon's explicit choice).
# SHOP_OPEN_HOUR=9
# SHOP_CLOSE_HOUR=18
# SHOP_LAST_BOOKING_HOUR=17
# SHOP_LAST_BOOKING_MINUTE=30
# How far ahead customers may book, and when day D stops taking bookings
# (BOOKING_CLOSE_HOUR local time on D-1; the nightly allocation runs then).
# BOOKING_HORIZON_DAYS=14
# BOOKING_CLOSE_HOUR=21
# Where the customer-facing deposit link points.
# PAYMENT_CHECKOUT_BASE_URL=https://payments.example.com/checkout
# Where this API is reachable from the browser (used for locally stored images).
# BACKEND_PUBLIC_URL=http://localhost:8000
